{
  "name": "pretty-pino-logs",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "package": "npm run build && bash scripts/package-plugin.sh",
    "dev": "webpack --mode development --watch",
    "sign": "grafana-sign-plugin",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "preview": "vite --config preview/vite.config.mjs"
  },
  "dependencies": {
    "@grafana/data": "12.2.0",
    "@grafana/runtime": "12.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@grafana/sign-plugin": "3.3.3",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "prettier": "^3.6.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.0",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "serialize-javascript": "7.1.2"
  }
}
